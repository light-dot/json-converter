{
  "name": "json-converter",
  "displayName": "JSON Converter",
  "description": "JSON格式化、压缩、Unicode转换等功能的可视化工具",
  "version": "0.0.1",
  "publisher": "cz",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Formatters",
    "Other"
  ],
  "keywords": [
    "json",
    "格式化",
    "压缩",
    "unicode",
    "JSON转换器"
  ],
  "license": "MIT",
  "icon": "images/JSON.png",
  "repository": {   
    "type": "git",
    "url": "https://github.com/light-dot/json-converter.git"
  },
  "activationEvents": [
    "onCommand:json-converter.openPanel",
    "onView:json-converter-icon"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "json-converter.openPanel",
        "title": "Open JSON Converter Panel"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "json-converter-container",
          "title": "JSON Converter",
          "icon": "$(json)"
        }
      ]
    },
    "views": {
      "json-converter-container": [
        {
          "id": "json-converter-icon",
          "name": "JSON Converter"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "json-converter.openPanel",
          "when": "view == json-converter-icon",
          "group": "navigation"
        }
      ],
      "activitybar/item/context": [
        {
          "command": "json-converter.openPanel",
          "when": "activitybarItem == json-converter-container"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "20.2.5",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.8",
    "@typescript-eslint/parser": "^5.59.8",
    "@vscode/test-electron": "^2.3.2",
    "eslint": "^8.41.0",
    "glob": "^8.1.0",
    "json-tree-view": "^0.4.12",
    "mocha": "^10.2.0",
    "prismjs": "^1.30.0",
    "typescript": "^5.1.3"
  }
}
